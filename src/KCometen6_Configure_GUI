# --- DUAL-AWARE SYSTEM PATHING MATRIX ---
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SYSTEM_SHARE_DIR = "/usr/share/kcometen6"
USER_CONFIG_DIR = os.path.expanduser("~/.config/kcometen6")

# 1. Detect if running from system-wide package or local portable folder
if os.path.exists(SYSTEM_SHARE_DIR) and not BASE_DIR.startswith("/home/"):
    # === SYSTEM PACKAGE INSTALL MODE ===
    ASSET_DIR = SYSTEM_SHARE_DIR
    ENGINE_BIN = "/usr/bin/kcometen6_run"
    IDLE_BIN = "/usr/bin/kcometen6_idle"

    # Secure configuration files in individual user home profile spaces
    os.makedirs(USER_CONFIG_DIR, exist_ok=True)
    CONFIG_PATH = os.path.join(USER_CONFIG_DIR, "settings.conf")
else:
    # === JOHN'S SIGNATURE 100% PORTABLE SANDBOX MODE ===
    ASSET_DIR = BASE_DIR
    ENGINE_BIN = os.path.join(BASE_DIR, "kcometen6_run")
    IDLE_BIN = os.path.join(BASE_DIR, "kcometen6_idle")

    # Keep the configuration file strictly trapped right inside this folder!
    CONFIG_PATH = os.path.join(BASE_DIR, "settings.conf")

# 2. Seed the active config tracker path from factory defaults if missing entirely
if not os.path.exists(CONFIG_PATH):
    default_conf_source = os.path.join(ASSET_DIR, "settings.conf")
    if os.path.exists(default_conf_source):
        shutil.copy(default_conf_source, CONFIG_PATH)

