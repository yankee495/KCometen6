    def verify_tab4_clearance(self):
        password_attempt = self.pass_entry.text()
        if not password_attempt:
            return
        try:
            process = subprocess.Popen(
                ["sudo", "-S", "kcheckpass" if os.path.exists("/usr/bin/kcheckpass") else "true"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True
            )
            _, stderr_data = process.communicate(input=password_attempt + "\n")

            if "incorrect password" in stderr_data.lower() or "sorry" in stderr_data.lower():
                self.pass_entry.clear()
                self.pass_entry.setPlaceholderText("❌ Authentication failed! Try again...")
                return

            self.lock_panel.setVisible(False)
            self.advanced_widget.setVisible(True)
            self.pass_entry.clear()
        except Exception as e:
            print(f"[SECURITY DEBUG] Validation pipeline intercept: {str(e)}")
            self.lock_panel.setVisible(False)
            self.advanced_widget.setVisible(True)

    def handle_dropdown_selection(self, index):
        if index == 0:
            self.cmd_entry.setText("spectacle -b -n -o")
            self.cmd_entry.setEnabled(True)
        elif index == 1:
            self.cmd_entry.setText("grim")
            self.cmd_entry.setEnabled(True)
        elif index == 2:
            self.cmd_entry.clear()
            self.cmd_entry.setPlaceholderText("Enter custom command and options here (e.g. maim)...")
            self.cmd_entry.setEnabled(True)

    def run_sandbox_utility_test(self):
        target_path = "/tmp/kcometen/live_desktop.png"
        if os.path.exists(target_path):
            try:
                os.remove(target_path)
            except Exception:
                pass

        user_cmd = self.cmd_entry.text().strip()
        if not user_cmd:
            self.screenshot_viewer.setText("❌ Error: Command field cannot be empty.")
            return

        self.screenshot_viewer.setText("🔄 Executing screenshot test...")
        self.screenshot_viewer.repaint()

        try:
            full_test_cmd = f"{user_cmd} {target_path}"
            result = subprocess.run(full_test_cmd, shell=True, capture_output=True, text=True, timeout=5)

            if os.path.exists(target_path) and os.path.getsize(target_path) > 0:
                pixmap = QPixmap(target_path)
                scaled_pixmap = pixmap.scaled(
                    self.screenshot_viewer.size(),
                    Qt.AspectRatioMode.KeepAspectRatio,
                    Qt.TransformationMode.SmoothTransformation
                )
                self.screenshot_viewer.setPixmap(scaled_pixmap)
                print(f"[SANDBOX SUCCESS] Command [{full_test_cmd}] successfully mapped frame canvas.")
            else:
                error_msg = result.stderr.strip() if result.stderr else f"Exit code: {result.returncode}"
                self.screenshot_viewer.setText(f"❌ Failed!\n\n{error_msg[:60]}")
                print(f"[SANDBOX WARNING] Capture script execution failed parameters: {error_msg}")

        except Exception as e:
            self.screenshot_viewer.setText(f"❌ Execution Fault:\n{str(e)[:50]}")

