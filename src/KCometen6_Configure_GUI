    def init_defaults(self):
        self.settings = {
            "cometCount": "60", "createInterval": "0.40", "sizeScale": "6.0", "timeScale": "1.0",
            "bgMode": "screenshot", "customBgFile": "", "customCeilingFile": "", "customFloorFile": "",
            "rotateComet": "true", "splitComet": "true", "curveComet": "true", "blitz": "true", "usePointSprites": "true",
            "colorMode": "3",

            # PERFORMANCE ENHANCEMENTS SELECTIONS:
            "maxFps": "60",
            "mipmaps": "false"
        }

    def load_config(self):
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        self.settings[k.strip()] = v.strip()
#   btn_preview.clicked.connect(lambda: [self.save_config(), os.system(f"{ENGINE_BIN} &")])
#                                               os.system(f"\"{IDLE_BIN}\" {seconds_val} &")
    def save_config(self):
        # 1. Capture the Active Screensaver Toggles from the Live Interface Layout
        screensaver_enabled = self.cb_screensaver.isChecked()
        timeout_minutes = self.timeout_slider.value()

        # FIXED LOGIC MATRIX: Explicitly flips the string key state for total manual editing clarity!
        self.settings["useSystemdScreensaver"] = "true" if screensaver_enabled else "false"
        self.settings["screensaverTimeout"] = str(timeout_minutes)

        # 2. Write out the core portable settings profile to your text file layout
        with open(CONFIG_PATH, "w") as f:
            f.write("# KCometen6 Standalone Portable Configuration Profile\n\n")
            for k, v in self.settings.items():
                f.write(f"{k} = {v}\n")

        # 3. Handle the background process threads seamlessly using your dual-aware binary hooks!
        if screensaver_enabled:
            seconds_val = int(timeout_minutes * 60)
            os.system("pkill -f kcometen6_idle >/dev/null 2>&1")
            # Wraps the IDLE_BIN variable path in escaped quotes so spaces never break execution!
            os.system(f"\"{IDLE_BIN}\" {seconds_val} &")
            print(f"[SUCCESS] Native kcometen6_idle companion process launched for {timeout_minutes} minute(s).")
        else:
            os.system("pkill -f kcometen6_idle >/dev/null 2>&1")
            os.system("pkill -f kcometen6_run >/dev/null 2>&1")
            print("[SUCCESS] Background tracking loops completely unlinked and dismantled.")
        # FIX: self.close() HAS BEEN COMMENTED OUT SO THE APP WINDOW STAYS OPEN!
        # self.close()

