    def handle_make_portable(self):
        """
        Dynamically extracts and bundles your active system binaries, assets,
        and dashboard elements to create a 100% self-contained portable folder!
        """
        from PyQt6.QtWidgets import QFileDialog, QMessageBox
        import shutil

        # 1. Spawn a native Qt file explorer prompt to let the user choose their export target directory
        target_parent_dir = QFileDialog.getExistingDirectory(self, "Select Destination Folder for Your KCometen6 Portable")
        if not target_parent_dir:
            return # User closed the window panel layout, cancel execution safely

        # Establish clear, standardized internal naming conventions for the portable sandbox folder
        portable_root = os.path.join(target_parent_dir, "KCometen6_Portable")

        try:
            # Wipe away any old broken directory remnants if they export to the same spot twice
            if os.path.exists(portable_root):
                shutil.rmtree(portable_root)
            os.makedirs(portable_root, exist_ok=True)

            # 2. Extract binaries based on your active dual-aware system environment paths
            # If the dashboard is running as a package out of /usr/, harvest global files natively
            if ENGINE_BIN.startswith("/usr/"):
                shutil.copy2("/usr/bin/kcometen6_run", os.path.join(portable_root, "kcometen6_run"))
                shutil.copy2("/usr/bin/kcometen6_idle", os.path.join(portable_root, "kcometen6_idle"))
                # Copy this running script file itself out as the root portable configuration utility
                shutil.copy2(os.path.abspath(__file__), os.path.join(portable_root, "KCometen6_Configure_GUI"))
            else:
                # If running locally from your current dev tree, harvest right from your local workspace paths
                shutil.copy2(ENGINE_BIN, os.path.join(portable_root, "kcometen6_run"))
                shutil.copy2(IDLE_BIN, os.path.join(portable_root, "kcometen6_idle"))
                shutil.copy2(os.path.abspath(__file__), os.path.join(portable_root, "KCometen6_Configure_GUI"))

            # 3. Pull your texture assets natively out of your live active ASSET_DIR gallery
            # This works flawlessly for both local folder structures and /usr/share/ layouts!
            if os.path.exists(ASSET_DIR):
                for filename in os.listdir(ASSET_DIR):
                    src_file = os.path.join(ASSET_DIR, filename)
                    # Skip packing loose configuration profiles so the portable folder can generate a fresh one!
                    if os.path.isfile(src_file) and not filename.endswith(".conf") and filename != "PKGBUILD":
                        shutil.copy2(src_file, os.path.join(portable_root, filename))

            # 4. Success alert block banner!
            QMessageBox.information(
                self,
                "Portable Folder Success!",
                f"Your 100% self-contained portable folder is ready!\n\nLocation: {portable_root}\n\nYou can now copy this folder anywhere or drop it on a USB drive."
            )

        except Exception as e:
            QMessageBox.critical(self, "Export Error", f"Failed to assemble portable folder directory channels:\n{str(e)}")

